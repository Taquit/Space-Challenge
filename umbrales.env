# Umbrales del sistema de salud. Edita aquí; NO hace falta tocar código. Reinicia el backend para aplicar.
# Formato CLAVE=valor. Las variables de entorno con el mismo nombre tienen prioridad sobre este archivo.
# Orientativo: no es diagnóstico médico. Valores revisables por personal médico.

# ---- Límites clínicos: PULSO (bpm) ----
PULSO_VIGILAR_MIN=60
PULSO_VIGILAR_MAX=100
PULSO_ALERTA_MIN=50
PULSO_ALERTA_MAX=110
PULSO_CRITICO_MIN=40
PULSO_CRITICO_MAX=130

# ---- Límites clínicos: SpO2 (%) (se compara "menor que") ----
SPO2_VIGILAR_MIN=95
SPO2_ALERTA_MIN=92
SPO2_CRITICO_MIN=90

# ---- Límites clínicos: PRESIÓN SISTÓLICA (mmHg) (máximos: "mayor o igual"; mínimos: "menor que") ----
SISTOLICA_VIGILAR_MAX=130
SISTOLICA_ALERTA_MAX=140
SISTOLICA_CRITICO_MAX=180
SISTOLICA_ALERTA_MIN=90
SISTOLICA_CRITICO_MIN=80

# ---- Límites clínicos: PRESIÓN DIASTÓLICA (mmHg) ----
DIASTOLICA_VIGILAR_MAX=80
DIASTOLICA_ALERTA_MAX=90
DIASTOLICA_CRITICO_MAX=120
DIASTOLICA_ALERTA_MIN=60
DIASTOLICA_CRITICO_MIN=50

# ---- Magnitudes derivadas ----
INDICE_CHOQUE_MAX=0.9
PRESION_PULSO_MIN=25
PRESION_PULSO_MAX=60

# ---- Persistencia y línea base ----
PERSISTENCIA_LECTURAS=3        # lecturas seguidas en alerta clínica para considerarla sostenida
BASELINE_LECTURAS=15           # lecturas iniciales que fijan la línea base personal

# ---- Deriva lenta (cambio acumulado mínimo, en unidades de la variable) ----
DERIVA_UMBRAL_PULSO=8
DERIVA_UMBRAL_SPO2=2
DERIVA_UMBRAL_SISTOLICA=10
DERIVA_UMBRAL_DIASTOLICA=6
DERIVA_SIGMAS=2                # el umbral también debe superar N desviaciones de la línea base
DERIVA_VENTANA_LECTURAS=36     # compara contra hace N lecturas (36 = ~6 h a 1 lectura/10 min)
DERIVA_PROMEDIO_LECTURAS=6     # lecturas que se promedian para suavizar ruido
DERIVA_REARME_LECTURAS=12      # lecturas sin deriva para volver a notificar

# ---- Tendencia ----
TENDENCIA_UMBRAL=0.05          # |pendiente| < umbral × desviación de la ventana => estable

# ---- Modelo personal (z-score del residuo) ----
MODELO_Z_ADVERTENCIA=2.0
MODELO_Z_ANOMALIA=3.0
MODELO_Z_ANOMALIA_ISO=2.5      # umbral menor si además Isolation Forest marca la lectura

# ---- Patrones entre variables ----
PATRON_SPO2_MAX=95             # SpO2 por debajo de este valor + pulso desviado => patrón respiratorio
PATRON_MIN_VARIABLES=3         # variables desviadas a la vez para "múltiples desviaciones"
