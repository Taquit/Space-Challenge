    "/tripulantes/{usuario}/salud/stream": {
      "get": {
        "tags": [
          "Salud en tiempo real"
        ],
        "summary": "Salud Stream",
        "description": "Datos en vivo (Server-Sent Events). Eventos:\n\n- `snapshot`: estado inicial (mismo contenido que `GET /tripulantes/{id}/salud`).\n- `lectura`: una lectura nueva `{timestamp, valores}`, cada vez que \"ocurre\" una.\n- `sueno`: una noche nueva `{timestamp, valores, fase, medicacion}` (solo tripulantes con datos de sueño).\n- `notificacion`: alerta nueva `{id, usuario, timestamp, severidad, variable, mensaje}`.\n- `fin`: ya no hay más datos (terminaron las lecturas y las noches).\n- `: ping`: comentario de keep-alive, el front puede ignorarlo.",
        "operationId": "salud_stream_tripulantes__usuario__salud_stream_get",
        "parameters": [
          {
            "name": "usuario",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Usuario"
            }
          },
          {
            "name": "limite",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10000,
              "minimum": 1,
              "default": 60,
              "title": "Limite"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/event-stream": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
