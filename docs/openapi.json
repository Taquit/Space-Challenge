        "parameters": [
          {
            "name": "usuario",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Usuario"
            }
          },
          {
            "name": "variables",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Medidas separadas por coma (p. ej. pulso,spo2). Vacío = todas",
              "title": "Variables"
            },
            "description": "Medidas separadas por coma (p. ej. pulso,spo2). Vacío = todas"
          },
          {
            "name": "limite",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 10000,
                  "minimum": 2
                },
                {
                  "type": "null"
                }
              ],
              "description": "Últimas N lecturas a resumir (vacío = todo lo transcurrido)",
              "title": "Limite"
            },
            "description": "Últimas N lecturas a resumir (vacío = todo lo transcurrido)"
          }
