    "/tripulantes/{usuario}/resumen": {
      "get": {
        "tags": [
          "Salud en tiempo real"
        ],
        "summary": "Resumen",
        "description": "Resumen de la(s) medida(s) seleccionada(s): estadísticas, tendencia, valor actual frente al\nrango esperado por el modelo personal del tripulante, interpretación clínica, derivadas y patrones.",
