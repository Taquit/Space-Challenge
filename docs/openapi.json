    "/tripulantes/{usuario}/cognitivo": {
      "post": {
        "tags": [
          "Salud en tiempo real",
          "Cognitivo"
        ],
        "summary": "Guardar Sesion Cognitiva",
        "description": "Guarda una sesión de pruebas cognitivas (PVT, DSST, Matrix) y devuelve la sesión con su `id` y el estado\ncognitivo resultante. Sesión que no cumple el esquema: 422 con código 9004.",
